{
	"name": "@potatoes/root",
	"version": "1.0.0",
	"description": "",
	"main": "index.js",
	"scripts": {
		"test": "vitest --run",
		"clean": "del-cli '**/dist' '**/*.tsbuildinfo'",
		"build": "tsc --build",
		"dev": "pnpm run \"/^watch:.*$/\"",
		"watch:ts": "tsc --build --watch",
		"watch:web": "pnpm -F web start",
		"format": "biome format .",
		"format:fix": "biome format --write .",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"lint:fix:unsafe": "biome check --write --unsafe ."
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.21.0",
			"onFail": "download"
		}
	},
	"packageManager": "pnpm@12.21.0",
	"type": "module",
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@iwsio/biome-config": "^1.0.3",
		"del-cli": "^8.0.1",
		"typescript": "^7.0.2",
		"vitest": "^5.1.0"
	}
}
